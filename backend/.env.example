# =========================================================
# Security / API
# =========================================================
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

SOC_INGESTION_API_KEY=change-me

CORS_ORIGINS=https://soc.local,http://localhost:3002
TRUSTED_HOSTS=soc.local,localhost,127.0.0.1,testserver,backend

# =========================================================
# Database / Cache / Vector Store
# =========================================================
DATABASE_URL=postgresql://soc_admin:change-me@postgres:5432/soc_db
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# =========================================================
# Keycloak / OpenID Connect
# =========================================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/soc
KEYCLOAK_REALM=soc
KEYCLOAK_CLIENT_ID=soc-backend

KEYCLOAK_ADMIN_CLIENT_ID=soc-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=

# =========================================================
# LLM / Groq
# =========================================================
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# =========================================================
# Threat Intelligence
# =========================================================
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true

# =========================================================
# SOAR
# =========================================================
SOAR_EXECUTION_MODE=dry_run

SOAR_ENABLE_BLOCK_IP=false
SOAR_ENABLE_ISOLATE_ENDPOINT=false
SOAR_ENABLE_DISABLE_USER=false
SOAR_ENABLE_SEND_NOTIFICATION=false

SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# =========================================================
# Shuffle SOAR
# =========================================================
SHUFFLE_ENABLED=false
SHUFFLE_WEBHOOK_URL=
SHUFFLE_WEBHOOK_SECRET=
SHUFFLE_VERIFY_SSL=true
SHUFFLE_TIMEOUT_SECONDS=15

# =========================================================
# Vault
# =========================================================
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=soc-backend
